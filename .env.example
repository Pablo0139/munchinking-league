# Entorno local de desarrollo — Munchinking League
# Copia este archivo a `.env` (para apps/web) y `.dev.vars` (para Cloudflare Workers local)

# Frontend (Vite)
VITE_APP_NAME="Munchinking League"
VITE_API_TRPC_URL="http://localhost:8787/trpc"
VITE_ASSETS_BASE_URL="http://localhost:5173/assets"

# Backend Worker (.dev.vars)
SESSION_SECRET="replace-with-a-random-64-char-hex-secret-in-local-dev"
APP_ORIGIN="http://localhost:5173"
APP_TIMEZONE="Europe/Madrid"
